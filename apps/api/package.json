{
  "name": "api",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --use-system-ca --env-file-if-exists=../../.env src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "dev:poll": "nodemon --legacy-watch --watch src --ext ts --exec \"tsx --use-system-ca --env-file-if-exists=../../.env src/server.ts\"",
    "migrate": "node --env-file-if-exists=../../.env ./node_modules/node-pg-migrate/bin/node-pg-migrate.js up -m migrations",
    "migrate:down": "node --env-file-if-exists=../../.env ./node_modules/node-pg-migrate/bin/node-pg-migrate.js down -m migrations",
    "migrate:create": "node --env-file-if-exists=../../.env ./node_modules/node-pg-migrate/bin/node-pg-migrate.js create -m migrations --migration-file-language sql",
    "seed": "tsx --env-file-if-exists=../../.env src/db/seed.ts",
    "llm:ping": "tsx --use-system-ca --env-file-if-exists=../../.env src/llm/ping.ts",
    "gen:try": "tsx --use-system-ca --env-file-if-exists=../../.env src/generation/try.ts",
    "gen:compare": "tsx --use-system-ca --env-file-if-exists=../../.env src/generation/compare.ts",
    "cost:report": "tsx --use-system-ca --env-file-if-exists=../../.env src/cost/report-cli.ts",
    "cost:sample": "tsx --use-system-ca --env-file-if-exists=../../.env src/cost/sample.ts",
    "cost:compare": "tsx --use-system-ca --env-file-if-exists=../../.env src/cost/compare-models.ts",
    "test:coverage": "vitest run --coverage",
    "seed:demo": "tsx --env-file-if-exists=../../.env src/demo/run-seed-demo.ts"
  },
  "dependencies": {
    "@describe-ia/shared": "workspace:*",
    "express": "^5.2.1",
    "multer": "^2.4.0",
    "node-pg-migrate": "^9.0.0",
    "pg": "^8.23.0",
    "sharp": "^0.35.5",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/multer": "^2.3.0",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "@vitest/coverage-v8": "^5.0.2",
    "nodemon": "^3.1.14",
    "supertest": "^7.3.0",
    "tsx": "^4.23.15",
    "vitest": "^5.0.2"
  }
}
