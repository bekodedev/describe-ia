# Postgres (docker compose reads these too)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=describeia
POSTGRES_PORT=5432

# API. Inside docker compose the host is overridden to "postgres".
DATABASE_URL=postgres://postgres:postgres@localhost:5432/describeia
PORT=4000

# LLM. Use a cheaper model for development and a better one in production.
ANTHROPIC_API_KEY=
LLM_MODEL=claude-haiku-4-5-20251001
# LLM_MODEL=claude-sonnet-5-5
# Per-request timeout for the LLM call, in milliseconds
LLM_TIMEOUT_MS=30000

# Language of the generated descriptions (ISO 639-1 code)
OUTPUT_LANGUAGE=es

# Web app -> API. Inside docker compose the host is overridden to "api".
API_URL=http://localhost:4000
